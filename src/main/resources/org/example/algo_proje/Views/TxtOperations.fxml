<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" stylesheets="@../Styles/TXTOperation.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.algo_proje.Controllers.TxtOperationsController">
    <children>
        <HBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>

                <VBox prefWidth="340.0" spacing="12.0" styleClass="sidebar-card">
                    <children>
                        <Label styleClass="header-label" text="Kontrol Paneli" />
                        <Separator prefWidth="200.0" />

                        <Label styleClass="section-label" text="KULLANICI BİLGİLERİ" />
                        <TextField fx:id="txtSourceID" promptText="Kaynak ID (Örn: 105)" />
                        <TextField fx:id="txtTargetID" promptText="Hedef ID (Örn: 108)" />

                        <Button fx:id="btnLoadFiles" maxWidth="Infinity" onAction="#handleLoadAllData" styleClass="button, btn-primary" text="📁 Verileri Yükle &amp; Graf Oluştur" />

                        <Separator prefWidth="200.0" />

                        <Label styleClass="section-label" text="İLİŞKİ İŞLEMLERİ" />

                        <HBox spacing="10">
                            <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleAreFriends" styleClass="button, btn-success" text="🤝 Arkadaş Mı?" />
                            <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleShowFriends" styleClass="button, btn-info" text="👥 Listele" />
                            <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleCommonFriends" styleClass="button, btn-info" text="🔗 Ortak Bul" />
                        </HBox>

                        <Button maxWidth="Infinity" onAction="#handleRecommendFriend" styleClass="button, btn-purple" text="➕ Arkadaş Önerisi Al" />
                        <Button maxWidth="Infinity" onAction="#handleRemoveFriend" styleClass="button, btn-danger" text="➖ Çıkarma Önerisi Al" />


                        <Separator prefWidth="200.0" />

                        <Label styleClass="section-label" text="ANALİZ &amp; İSTATİSTİK" />

                        <Button maxWidth="Infinity" onAction="#handleGeneralRanking" styleClass="button, btn-primary" text="📊 Genel Sıralama" />

                        <HBox spacing="10">
                            <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleMostLiked" styleClass="button, btn-warning" text="❤️ En Çok Like" />
                            <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#handleMostCommented" styleClass="button, btn-warning" text="💬 En Çok Yorum" />
                        </HBox>

                        <Separator prefWidth="200.0" />

                        <Label styleClass="section-label" text="GÖRSELLEŞTİRME" />
                        <Button maxWidth="Infinity" onAction="#handleShowGraph" styleClass="button, btn-purple" text="🌐 Graf Yapısını Göster (GUI)" />
                    </children>
                </VBox>

                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="header-label" text="Sistem Çıktıları ve Loglar" />

                        <TextArea fx:id="txtDisplayArea" editable="false" styleClass="console-area" VBox.vgrow="ALWAYS" wrapText="true" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
                            <children>
                                <Label styleClass="status-label" text="DURUM:" />
                                <Label fx:id="lblStatus" text="Sistem Hazır. Lütfen verileri yükleyin." textFill="#555555" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>