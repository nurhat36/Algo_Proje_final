<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.algo_proje.Controllers.TxtOperationsController">
    <children>
        <HBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <!-- Sol Panel - Kontrol Butonları -->
                <VBox prefWidth="320.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Kontrol Paneli" textFill="#1a73e8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <!-- Giriş Alanları -->
                        <Label text="Kullanıcı ID (Kaynak):" />
                        <TextField fx:id="txtSourceID" promptText="Örn: 105" />

                        <Label text="Hedef ID (Opsiyonel):" />
                        <TextField fx:id="txtTargetID" promptText="Örn: 108" />

                        <!-- Veri Yükleme -->
                        <Button fx:id="btnLoadFiles" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLoadAllData" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 10;" text="📁 Verileri Yükle (Graf Oluştur)" />

                        <Separator prefWidth="200.0" />

                        <!-- Temel İşlemler -->
                        <Label text="Temel İşlemler:" style="-fx-font-weight: bold;" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleAreFriends" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-padding: 8;" text="🤝 Arkadaş Mı?" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleShowFriends" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8;" text="👥 Arkadaşları Göster" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleRecommendFriend" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 8;" text="➕ Arkadaş Öner" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleRemoveFriend" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8;" text="➖ Arkadaş Çıkarma Öner" />

                        <Separator prefWidth="200.0" />

                        <!-- İstatistikler -->
                        <Label text="İstatistikler:" style="-fx-font-weight: bold;" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleGeneralRanking" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-padding: 8;" text="📊 Genel Sıralama" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleMostLiked" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 8;" text="❤️ En Çok Beğeni Alanlar" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleMostCommented" style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-padding: 8;" text="💬 En Çok Yorum Alanlar" />

                        <Separator prefWidth="200.0" />

                        <!-- Görselleştirme -->
                        <Label text="Görselleştirme:" style="-fx-font-weight: bold;" />

                        <Button maxWidth="1.7976931348623157E308" onAction="#handleShowGraph" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-padding: 8;" text="🌐 Graf Yapısını Göster" />
                    </children>
                </VBox>

                <!-- Sağ Panel - Çıktı Alanı -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="İşlem Çıktıları">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <TextArea fx:id="txtDisplayArea" editable="false" style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 13;" VBox.vgrow="ALWAYS" wrapText="true" />

                        <!-- Durum Çubuğu -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #e8f0fe; -fx-padding: 8; -fx-background-radius: 5;">
                            <children>
                                <Label text="Durum:" textFill="#1967d2">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblStatus" text="Sistem Hazır. Lütfen verileri yükleyin." />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>